# Explys mobile — environment (copy to `.env` and adjust)

# API origin without trailing slash.
# Android emulator → host machine: http://10.0.2.2:4200/api
# iOS Simulator → host machine: http://localhost:4200/api
# Physical device → your Mac LAN IP: http://192.168.x.x:4200/api
EXPO_PUBLIC_API_BASE_URL=https://api.explys.com

# Optional staging Basic Auth (same as web `VITE_API_BASIC_AUTH_*`)
EXPO_PUBLIC_API_BASIC_AUTH_USER=
EXPO_PUBLIC_API_BASIC_AUTH_PASSWORD=

# Optional API token header
EXPO_PUBLIC_API_TOKEN=

# Relax subscription gate for local/staging (mirrors web `VITE_SKIP_SUBSCRIPTION_ENFORCEMENT`)
EXPO_PUBLIC_SKIP_SUBSCRIPTION_ENFORCEMENT=true

# Cloudflare Turnstile site key (same as web app)
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADSk3etSiWLwGH5-

EXPO_PUBLIC_LOG_API_ERRORS=1
