{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "base-64": "^1.0.0",
    "expo": "~56.0.11",
    "expo-constants": "~56.0.18",
    "expo-font": "^56.0.6",
    "expo-linear-gradient": "^56.0.4",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-video": "~56.1.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/base-64": "^1.0.2",
    "@types/react": "~19.2.2",
    "expo-build-properties": "^56.0.18",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preandroid": "node scripts/ensure-android-local-properties.mjs",
    "android": "expo run:android",
    "android:install": "node scripts/install-android-debug-apk.mjs",
    "android:connect": "node scripts/setup-android-metro.mjs",
    "android:repair": "node scripts/repair-android-build.mjs && node scripts/ensure-android-local-properties.mjs",
    "prebuild:android": "node scripts/ensure-android-local-properties.mjs",
    "prebuild:ios": "node scripts/prebuild-ios.mjs",
    "build:apk": "node scripts/ensure-android-local-properties.mjs && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64",
    "build:apk:debug": "node scripts/ensure-android-local-properties.mjs && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "preios": "node scripts/ensure-ios-project.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit"
  },
  "private": true
}
